# ==============================================================================
# SlopeSense AI - Environment Configuration Template
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Database Configuration (PostgreSQL in production, SQLite fallback for local dev)
DATABASE_URL=sqlite:///./slopesense.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slopesense_db

# JWT Security
JWT_SECRET_KEY=slopesense-super-secret-key-sih-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Twilio Multi-Channel Alerts (SMS & Voice IVR)
# Set TWILIO_MOCK_MODE=false and fill below credentials for live SMS/IVR dispatch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MOCK_MODE=true

# Google Earth Engine (GEE)
GEE_PROJECT=slopesense-ner-landslide
